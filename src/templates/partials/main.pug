    #oil-grid.oil-grid

section#gallery.service-gallery.section(aria-labelledby='gallery-title')
  .container
    .gallery-head
      div
        p.section-kicker Сервис в работе
        h2#gallery-title
          | Здесь знают,
          br
          em что делают.
      p.gallery-intro Показываем сервис таким, какой он есть: собственный техцентр, оборудованные посты и мастера, которые работают аккуратно и по делу.
    .gallery-carousel(data-carousel, role='region', aria-roledescription='карусель', aria-label='Фотографии сервиса Pro Масло')
      .gallery-viewport
        .gallery-track
          figure.gallery-slide.is-active
            img(src='/images/garage-exterior.webp', alt='Фасад автосервиса Pro Масло на Шафировском путепроводе', loading='lazy')
            figcaption
              span 01
              | Наш техцентр снаружи
          figure.gallery-slide
            img(src='/images/garage-lift.webp', alt='Автомобиль на подъёмнике в сервисном посту Pro Масло', loading='lazy')
            figcaption
              span 02
              | Рабочий пост
          figure.gallery-slide
            img(src='/images/garage-parts.webp', alt='Стеллажи с маслами и фильтрами в сервисе Pro Масло', loading='lazy')
            figcaption
              span 03
              | Масла и фильтры в наличии
          figure.gallery-slide
            img(src='/images/garage-mechanic.webp', alt='Мастер Pro Масло обслуживает двигатель автомобиля', loading='lazy')
            figcaption
              span 04
              | Работа мастера
      .gallery-controls
        button.gallery-arrow(type='button', data-carousel-prev, aria-label='Предыдущая фотография') ←
        .gallery-dots(aria-label='Выбрать фотографию')
          button(type='button', data-carousel-dot='0', aria-label='Фотография 1', aria-current='true')
          button(type='button', data-carousel-dot='1', aria-label='Фотография 2')
          button(type='button', data-carousel-dot='2', aria-label='Фотография 3')
          button(type='button', data-carousel-dot='3', aria-label='Фотография 4')
        span.gallery-counter(aria-live='polite')
          span(data-carousel-current) 01
          |  / 04
        button.gallery-arrow(type='button', data-carousel-next, aria-label='Следующая фотография') →

